        { "driver": "linux", "file": "scripts/ui-smoke-linux.sh", "kind": "regex", "pattern": "via AT-SPI.*pasting allowed" },
        {
          "driver": "linux",
          "file": "tests/ui/linux/hard-cases.sh",
          "kind": "regex",
          "pattern": "read $length characters via AT-SPI.*pasting allowed",
          "vars": { "$length": "1234" }
        }
      ]
    },
