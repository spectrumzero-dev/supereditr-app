{
  "comment": "capture.log lines the end-to-end UI drivers read. `text` is a line as the type `writer` in src-tauri/src/platform/log_lines.rs writes it, without the timestamp that `platform::trace` puts before it (`timestamp` under `drivers` is an example of that platform's). Each of `matched_by` is a pattern a driver matches on the line, written exactly as it appears in `file`; `vars` are the driver's variables in it and the values they take for this line. `kind` is how the driver matches: `substring` for a plain contains (Swift `contains`, `grep -F`), `regex` for a case-sensitive regular expression (Swift `.regularExpression`, `grep`, `grep -E`, awk, sed -E), `regex-ignore-case` for PowerShell's `-match`. Each pattern is matched against the timestamp, a space and `text`. Read by src-tauri/src/platform/log_lines/tests.rs.",
  "drivers": {
    "macos": { "timestamp": "1763500000" },
    "linux": { "timestamp": "1763500000.123" },
    "windows": { "timestamp": "1763500000.123" }
  },
  "lines": [
    {
      "id": "read-accessibility",
      "writer": "Read",
      "text": "shortcut com.google.Chrome: read 42 characters of 42 in the field via Accessibility in 12ms; replacing allowed",
      "matched_by": [
        { "driver": "macos", "file": "tests/ui/smoke.swift", "kind": "substring", "pattern": "com.google.Chrome: read" },
        { "driver": "macos", "file": "tests/ui/smoke.swift", "kind": "substring", "pattern": "via Accessibility" }
      ]
    },
    {
